<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.way_ne.mapper.DeptMapper">
    <select id="findAll" resultType="com.way_ne.pojo.Dept">
        select id, name, create_time, update_time from dept order by update_time desc;
    </select>

    <delete id="deleteById">
        delete from dept where id=#{deptId}
    </delete><!--将要映射的类的引用地址-->

    <insert id="add">
        insert into dept(name, create_time, update_time) values(#{name},#{createTime},#{updateTime})
    </insert>

    <select id="getId" resultType="com.way_ne.pojo.Dept">
        select id, name, create_time, update_time from dept where id=#{id}
    </select>

    <update id="update">
        update dept set name=#{name} where id=#{id}
    </update>
</mapper>