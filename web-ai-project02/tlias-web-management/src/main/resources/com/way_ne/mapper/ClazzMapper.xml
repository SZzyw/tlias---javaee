<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.way_ne.mapper.ClazzMapper">

    <select id="findAll" resultType="com.way_ne.pojo.Clazz">
        select c.*,e.name masterName from clazz c left join emp e on e.id=c.master_id
        <where>
            <if test="name!=null and name!=''">
                and c.name like concat('%',#{name},'%')
            </if>
            <if test="begin!=null and end!=null">
                and c.end_date between #{begin} and #{end}
            </if>
        </where>
    </select>

    <delete id="deleteById">
        delete from clazz where clazz.id=#{ids};
    </delete>

    <insert id="addClazz">
        insert into clazz(name,room,begin_date,end_date,master_id,subject,create_time,update_time)
        values(#{name},#{room},#{beginDate},#{endDate},#{masterId},#{subject},#{createTime},#{updateTime});
    </insert>

    <select id="getById" resultType="com.way_ne.pojo.Clazz">
        select * from clazz where clazz.id=#{id};
    </select>

    <update id="updateClazz">
            update clazz set name=#{name},room=#{room},begin_date=#{beginDate},end_date=#{endDate},master_id=#{masterId},subject=#{subject},update_time=#{updateTime}
            where clazz.id=#{id};
    </update>

    <select id="list" resultType="com.way_ne.pojo.Clazz">
        select * from clazz
    </select>
</mapper>